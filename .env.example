# ==============================================================================
# FitAura - Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# Never commit .env or files containing real secrets to version control.
# ==============================================================================

# Database Connection (Supported: DB_URL / FITAURA_DB_URL)
# JDBC connection string for MySQL database.
DB_URL=jdbc:mysql://localhost:3306/fitaura?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
FITAURA_DB_URL=jdbc:mysql://localhost:3306/fitaura?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Database Authentication (Supported: DB_USERNAME or DB_USER / FITAURA_DB_USERNAME)
DB_USERNAME=your_database_username
FITAURA_DB_USERNAME=your_database_username

# Database Password (Supported: DB_PASSWORD / FITAURA_DB_PASSWORD)
DB_PASSWORD=your_database_password
FITAURA_DB_PASSWORD=your_database_password

# HikariCP Connection Pool Settings (Supported: DB_MAX_POOL_SIZE, DB_MIN_IDLE)
DB_MAX_POOL_SIZE=10
FITAURA_DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
FITAURA_DB_MIN_IDLE=2

# Administrator Bootstrap (Optional for automatic initial admin provisioning)
# Supported: ADMIN_EMAIL / FITAURA_ADMIN_EMAIL, ADMIN_PASSWORD / FITAURA_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
FITAURA_ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
FITAURA_ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=System Administrator
FITAURA_ADMIN_NAME=System Administrator

# Application Server & Hosting Configuration (Optional)
APP_URL=http://localhost:8080/fitaura
PORT=8080

# Optional API Keys
GEMINI_API_KEY=your_api_key_here
